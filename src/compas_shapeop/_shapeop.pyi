from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray

from compas.typing import RealInput

class SolverWrapper:
    def __init__(self) -> None: ...
    def set_points(self, points_array: NDArray[np.float64], /) -> None: ...
    def get_points(self) -> NDArray[np.float64]: ...
    def add_closeness_constraint(self, vertex_index: int, weight: float, /) -> bool: ...
    def add_closeness_constraint_with_position(self, vertex_index: int, weight: float, x: RealInput, y: RealInput, z: RealInput, /) -> bool: ...
    def add_edge_strain_constraint(self, vertex_index1: int, vertex_index2: int, weight: float, min_range: float, max_range: float, /) -> bool: ...
    def add_shrinking_edge_constraint(self, vertex_index1: int, vertex_index2: int, weight: float, shrink_factor: float, /) -> bool: ...
    def add_circle_constraint(self, indices: Sequence[int], weight: float, /) -> bool: ...
    def add_plane_constraint(self, indices: Sequence[int], weight: float, /) -> bool: ...
    def add_similarity_constraint(self, indices: Sequence[int], weight: float, allow_scaling: bool, allow_rotation: bool, allow_translation: bool, /) -> bool: ...
    def add_regular_polygon_constraint(self, indices: Sequence[int], weight: float, /) -> bool: ...
    def add_shape_constraint(
        self,
        indices: Sequence[int],
        shape_type: str,
        weight: float,
        allow_scaling: bool,
        allow_rotation: bool,
        allow_translation: bool,
        custom_points: Sequence[Sequence[float]],
        /,
    ) -> bool: ...
    def add_bending_constraint(self, indices: Sequence[int], weight: float, min_range: float = ..., max_range: float = ..., /) -> bool: ...
    def add_normal_force_with_faces(self, faces_flat_array: NDArray[np.int32], face_sizes_array: NDArray[np.int32], magnitude: float, /) -> bool: ...
    def add_vertex_force(self, force_x: float, force_y: float, force_z: float, vertex_id: int, /) -> bool: ...
    def add_gravity_force(self, force_x: float, force_y: float, force_z: float, /) -> bool: ...
    def initialize(self, dynamic: bool = ..., masses: float = ..., damping: float = ..., timestep: float = ..., /) -> bool: ...
    def solve(self, iterations: int, /) -> bool: ...
